{
  "name": "tcs-quotidiano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototipo locale del blog Briefly.tcs (sito pubblico in inglese): Astro statico con componenti React renderizzati in build.",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "TCS_CONTENT_SOURCE=supabase ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:fixture": "TCS_CONTENT_SOURCE=fixture ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && TCS_CONTENT_SOURCE=fixture node --test \"tests/*.test.ts\"",
    "build": "TCS_CONTENT_SOURCE=supabase node scripts/build.ts",
    "build:fixture": "TCS_CONTENT_SOURCE=fixture node scripts/build.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "supabase": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase",
    "db:start": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase start --runtime native --output-format json > /dev/null && node scripts/write-env.ts",
    "db:stop": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase stop",
    "db:reset": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase db reset --local",
    "db:advisors": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase db advisors --local --type all --level info",
    "db:env": "node scripts/write-env.ts",
    "db:seed:generate": "node scripts/generate-seed.ts",
    "db:verify": "node scripts/verify-db.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "astro": "7.4.4",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/hast": "3.0.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.122.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
