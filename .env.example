# Esempio dei valori letti dalla build. Nessun segreto in questo file.
#
# Target scelto da TCS_SUPABASE_TARGET (impostata dagli script npm): local (predefinito) o cloud.
# Precedenza, variabile per variabile: ambiente del processo > file del target. Nessun ripiego tra i due file
# né sulle fixture. Solo la chiave publishable (ruolo anon, soggetta a RLS): secret e service_role sono rifiutate.

# --- Target local: file .env, scritto da `npm run db:env` con i valori dello stack locale ---
# URL dell'API dello stack Supabase locale (solo loopback: 127.0.0.1, localhost, [::1]).
TCS_SUPABASE_URL=http://127.0.0.1:55321
TCS_SUPABASE_PUBLISHABLE_KEY=

# --- Target cloud: file .env.cloud (ignorato da Git), oppure variabili d'ambiente (es. Vercel) ---
# Usato da `npm run build:cloud` e `npm run dev:cloud`. Il target cloud non legge mai .env.
# TCS_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
# TCS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
