# Copiato in .env da `npm run db:env` con i valori dello stack locale. Nessun segreto in questo file.
# URL dell'API dello stack Supabase locale (solo 127.0.0.1).
TCS_SUPABASE_URL=http://127.0.0.1:55321
# Chiave publishable locale (ruolo anon, soggetta a RLS). Mai la chiave secret o service_role.
TCS_SUPABASE_PUBLISHABLE_KEY=
