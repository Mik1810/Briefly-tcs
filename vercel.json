{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "posts": false
    }
  },
  "redirects": [
    { "source": "/archivio", "destination": "/archive/", "permanent": true },
    { "source": "/archivio/", "destination": "/archive/", "permanent": true },
    { "source": "/metodo", "destination": "/method/", "permanent": true },
    { "source": "/metodo/", "destination": "/method/", "permanent": true },
    { "source": "/argomenti", "destination": "/topics/", "permanent": true },
    { "source": "/argomenti/:path*", "destination": "/topics/:path*", "permanent": true }
  ]
}
