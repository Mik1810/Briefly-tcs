{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "posts": false
    }
  },
  "redirects": [
    { "source": "/archivio", "destination": "/archive/", "permanent": true },
    { "source": "/archivio/", "destination": "/archive/", "permanent": true },
    { "source": "/metodo", "destination": "/method/", "permanent": true },
    { "source": "/metodo/", "destination": "/method/", "permanent": true },
    { "source": "/argomenti", "destination": "/", "permanent": true },
    { "source": "/argomenti/(.*)", "destination": "/", "permanent": true },
    { "source": "/topics", "destination": "/", "permanent": true },
    { "source": "/topics/(.*)", "destination": "/", "permanent": true }
  ]
}
