---
// KaTeX: CSS e font serviti localmente, inclusi solo nelle pagine articolo.
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleMeta from '../../components/ArticleMeta.tsx';
import BriefingNav from '../../components/BriefingNav.tsx';
import DemoLabel from '../../components/DemoLabel.tsx';
import HtmlBody from '../../components/HtmlBody.tsx';
import ResultIndex from '../../components/ResultIndex.tsx';
import ResultSection from '../../components/ResultSection.tsx';
import { adjacentBriefings, getSite } from '../../lib/content/repository.ts';
import { RESULT_ACTIONS_SCRIPT } from '../../lib/result-actions.ts';
import type { Briefing } from '../../lib/content/types.ts';
import { renderMarkdown } from '../../lib/markdown.ts';

export async function getStaticPaths() {
  const site = await getSite();
  return site.briefings.map((briefing) => ({ params: { date: briefing.date }, props: { briefing } }));
}

interface Props {
  briefing: Briefing;
}

const { briefing } = Astro.props;
const site = await getSite();
const { newer, older } = adjacentBriefings(site, briefing.date);
const introHtml = briefing.intro ? renderMarkdown(briefing.intro, `briefing ${briefing.date} › intro`) : null;
const results = briefing.results.map((result) => ({
  result,
  bodyHtml: renderMarkdown(result.body, `briefing ${briefing.date} › risultato ${result.id}`),
}));
---

<BaseLayout title={briefing.title} description={briefing.summary} current="articoli" currentIsPage={false}>
  <article class="article">
    <header class="article-header">
      <DemoLabel demo={briefing.demo} />
      <h1 class="article-title">{briefing.title}</h1>
      <p class="article-summary">{briefing.summary}</p>
      <ArticleMeta briefing={briefing} />
    </header>

    {
      briefing.demo ? (
        <p class="demo-notice">
          This is a layout example. The results described are classic textbook results, not research news, and serve
          only to test the prototype.
        </p>
      ) : null
    }

    <ResultIndex results={briefing.results} />
    {introHtml ? <HtmlBody html={introHtml} className="prose article-intro" /> : null}

    {
      results.map(({ result, bodyHtml }, index) => (
        <ResultSection result={result} bodyHtml={bodyHtml} position={index + 1} />
      ))
    }

    {
      /* L'uso dell'AI dichiarato dagli autori sta in ogni risultato ("AI use"); quello del sito nel footer e in
         Method. Solo i demo mostrano ancora la propria dichiarazione. */
      briefing.demo ? (
        <section class="disclosure" aria-labelledby="ai-heading">
          <h2 id="ai-heading" class="section-heading">Role of AI and review</h2>
          <p>{briefing.aiDisclosure}</p>
        </section>
      ) : null
    }
  </article>
  <script is:inline set:html={RESULT_ACTIONS_SCRIPT} />
  <BriefingNav newer={newer} older={older} />
</BaseLayout>
