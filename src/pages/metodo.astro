---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FORMALIZATION_LABELS, PUBLICATION_LABELS, VERIFICATION_LABELS } from '../lib/content/labels.ts';
import { getSite } from '../lib/content/repository.ts';

// URL /metodo/ invariato per conservare i permalink; contenuto pubblico in inglese.
const site = await getSite();
const statusGroups = [
  { name: 'Publication', labels: Object.values(PUBLICATION_LABELS) },
  { name: 'Formalization', labels: Object.values(FORMALIZATION_LABELS) },
  { name: 'Verification', labels: Object.values(VERIFICATION_LABELS) },
];
---

<BaseLayout
  title="Method"
  description="How sources are chosen, what role AI plays, and how review and corrections work."
  current="metodo"
>
  <article class="article">
    <header class="article-header">
      <h1 class="article-title">Method</h1>
      <p class="article-summary">How sources will be chosen, what role AI will play, and how review and corrections work.</p>
    </header>

    <div class="prose">
      <h2>Current status</h2>
      <p>
        This site is a local prototype. Every article currently on it is <strong>demo content</strong>: it describes
        classic textbook results to test layout, formulas, and corrections. None of it is research news.
      </p>
      <p>
        Data for this build: {site.sourceDescription}.{' '}
        {
          site.sourceKind === 'supabase'
            ? 'The pages are generated at build time by reading the Supabase database.'
            : 'This is an offline demo build: the reference database is a local Supabase instance.'
        }{' '}
        The editorial process described below is a project commitment, not yet a working procedure.
      </p>

      <h2>One briefing a day</h2>
      <p>
        The unit of publication is the daily briefing, with one or more results. Each result has its own scientific
        status and sources, and a direct link to its section. Standalone in-depth pieces may accompany the
        briefings when a subject calls for it. If a day brings no significant news, nothing is published to fill the gap.
      </p>

      <h2>Sources</h2>
      <p>
        Primary sources are preferred: manuscripts, arXiv, ECCC, conference proceedings, and authors’ pages. The version
        consulted is cited. A reachable link is not enough to verify a theorem: the content must be checked to support
        the stated claim.
      </p>

      <h2>Scientific status</h2>
      <p>
        The status of a result has three independent dimensions, shown as text next to the result. A preprint, for
        example, may already be formalized.
      </p>
      <dl class="status-vocabulary">
        {
          statusGroups.map((group) => (
            <div>
              <dt>{group.name}</dt>
              <dd>{group.labels.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>

      <h2>Role of AI</h2>
      <p>
        AI may help with gathering and drafting, never while the site is being read: pages are generated in advance and
        served as static HTML. Every article states the actual role of AI and the level of review carried out. An
        automated check is presented as such, without calling it a mathematical review.
      </p>

      <h2>Review and drafts</h2>
      <p>Texts start as drafts and are published only after review. Drafts do not appear on any page of the site.</p>

      <h2>Corrections</h2>
      <p>
        Every correction records its date and a description, and updates the article’s date. Substantive corrections are
        also flagged at the top of the article; minor ones appear only in the final list.
      </p>
    </div>
  </article>
</BaseLayout>
