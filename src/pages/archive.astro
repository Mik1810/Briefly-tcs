---
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefingRow from '../components/BriefingRow.tsx';
import { briefingTopics, briefingsByYear, getSite } from '../lib/content/repository.ts';

const site = await getSite();
const years = briefingsByYear(site);
---

<BaseLayout title="Archive" description="All published briefings, most recent first." current="archivio">
  <header class="page-header">
    <h1 class="page-title">Archive</h1>
    <p class="page-intro">All published briefings, most recent first, grouped by year.</p>
  </header>
  {
    years.length === 0 ? (
      <p class="empty">No published briefings.</p>
    ) : (
      years.map(([year, briefings]) => (
        <section class="list" aria-labelledby={`anno-${year}`}>
          <h2 id={`anno-${year}`} class="section-heading">
            {year}
          </h2>
          {briefings.map((briefing) => (
            <BriefingRow briefing={briefing} topics={briefingTopics(site, briefing)} headingLevel={3} />
          ))}
        </section>
      ))
    )
  }
</BaseLayout>
