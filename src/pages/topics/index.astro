---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entriesByTopic, getSite, topicPath } from '../../lib/content/repository.ts';

const site = await getSite();
const entries = entriesByTopic(site);
// Solo argomenti con almeno un risultato pubblicato: nessuna pagina vuota.
const topics = site.topics.filter((topic) => entries.has(topic.slug));
---

<BaseLayout title="Topics" description="Published results, grouped by topic." current="argomenti">
  <header class="page-header">
    <h1 class="page-title">Topics</h1>
    <p class="page-intro">
      Each result in a briefing has its own topics. Topic pages list individual results, each linking to its own
      section.
    </p>
  </header>
  {
    topics.length === 0 ? (
      <p class="empty">No published results.</p>
    ) : (
      <ul class="topic-list">
        {topics.map((topic) => {
          const count = entries.get(topic.slug)?.length ?? 0;
          return (
            <li>
              <h2 class="row-title">
                <a href={topicPath(topic)}>{topic.name}</a>
              </h2>
              <p class="row-summary">
                {topic.description} <span class="meta">{count === 1 ? '1 result' : `${count} results`}</span>
              </p>
            </li>
          );
        })}
      </ul>
    )
  }
</BaseLayout>
