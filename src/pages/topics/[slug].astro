---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResultRow from '../../components/ResultRow.tsx';
import { entriesByTopic, getSite, type TopicEntry } from '../../lib/content/repository.ts';
import type { Topic } from '../../lib/content/types.ts';

export async function getStaticPaths() {
  const site = await getSite();
  const entries = entriesByTopic(site);
  return site.topics.flatMap((topic) => {
    const list = entries.get(topic.slug);
    return list ? [{ params: { slug: topic.slug }, props: { topic, entries: list } }] : [];
  });
}

interface Props {
  topic: Topic;
  entries: TopicEntry[];
}

const { topic, entries } = Astro.props;
---

<BaseLayout title={topic.name} description={topic.description} current="argomenti" currentIsPage={false}>
  <header class="page-header">
    <p class="eyebrow"><a href="/topics/">Topics</a></p>
    <h1 class="page-title">{topic.name}</h1>
    <p class="page-intro">{topic.description}</p>
  </header>
  <section class="list" aria-label={`Results on ${topic.name}`}>
    {entries.map(({ briefing, result }) => <ResultRow briefing={briefing} result={result} />)}
  </section>
</BaseLayout>
